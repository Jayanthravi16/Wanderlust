<% layout("/layouts/boilerplate.ejs") %>

<main class="listing-form-page signup-page">
    <h1 class="listing-form-heading">Join WanderLust</h1>
    <p class="signup-intro">Find your place to stay and make every trip unforgettable.</p>

    <form action="/signup" method="post" class="listing-form needs-validation" novalidate>
        <div class="listing-field">
            <label for="username" class="listing-label">Username</label>
            <input
                type="text"
                name="username"
                id="username"
                class="form-control listing-input"
                placeholder="Choose a username"
                autocomplete="username"
                required
            >
            <div class="invalid-feedback">Please enter a username.</div>
        </div>

        <div class="listing-field">
            <label for="email" class="listing-label">Email</label>
            <input
                type="email"
                name="email"
                id="email"
                class="form-control listing-input"
                placeholder="you@example.com"
                autocomplete="email"
                required
            >
            <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>

        <div class="listing-field">
            <label for="password" class="listing-label">Password</label>
            <input
                type="password"
                name="password"
                id="password"
                class="form-control listing-input"
                placeholder="Create a password"
                autocomplete="new-password"
                required
            >
            <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button class="listing-submit" type="submit">Create account</button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
</main>
