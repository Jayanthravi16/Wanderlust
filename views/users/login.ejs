<% layout("/layouts/boilerplate.ejs") %>

<main class="listing-form-page signup-page">
    <h1 class="listing-form-heading">WanderLust</h1>
    <p class="signup-intro">Sign in to find your next unforgettable stay.</p>

    <form action="/login" method="post" class="listing-form needs-validation" novalidate>
        <div class="listing-field">
            <label for="username" class="listing-label">Username</label>
            <input
                type="text"
                name="username"
                id="username"
                class="form-control listing-input"
                placeholder="Enter your username"
                autocomplete="username"
                required
            >
            <div class="invalid-feedback">Please enter a username.</div>
        </div>

        <div class="listing-field">
            <label for="password" class="listing-label">Password</label>
            <input
                type="password"
                name="password"
                id="password"
                class="form-control listing-input"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
            >
            <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button class="listing-submit" type="submit">Log in</button>
    </form>
    <p class="auth-switch">New to WanderLust? <a href="/signup">Create an account</a></p>
</main>
