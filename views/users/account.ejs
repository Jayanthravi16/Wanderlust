<% layout("/layouts/boilerplate.ejs") %>

<main class="listing-form-page account-page">
    <h1 class="listing-form-heading">Manage profile</h1>
    <p class="signup-intro">Update your password or manage your WanderLust account.</p>

    <section class="account-section">
        <h2 class="account-section-heading">Profile details</h2>
        <dl class="account-details">
            <div>
                <dt>Username</dt>
                <dd><%= currUser.username %></dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd><%= currUser.email %></dd>
            </div>
        </dl>
    </section>

    <section class="account-section">
        <h2 class="account-section-heading">Change password</h2>
        <form action="/account/password" method="post" class="listing-form needs-validation" novalidate>
            <div class="listing-field">
                <label for="currentPassword" class="listing-label">Current password</label>
                <input
                    type="password"
                    name="currentPassword"
                    id="currentPassword"
                    class="form-control listing-input"
                    autocomplete="current-password"
                    required
                >
                <div class="invalid-feedback">Enter your current password.</div>
            </div>

            <div class="listing-field">
                <label for="newPassword" class="listing-label">New password</label>
                <input
                    type="password"
                    name="newPassword"
                    id="newPassword"
                    class="form-control listing-input"
                    autocomplete="new-password"
                    required
                >
                <div class="invalid-feedback">Enter a new password.</div>
            </div>

            <div class="listing-field">
                <label for="confirmPassword" class="listing-label">Confirm new password</label>
                <input
                    type="password"
                    name="confirmPassword"
                    id="confirmPassword"
                    class="form-control listing-input"
                    autocomplete="new-password"
                    required
                >
                <div class="invalid-feedback">Confirm your new password.</div>
            </div>

            <button class="listing-submit" type="submit">Change password</button>
        </form>
    </section>

    <section class="account-danger-zone">
        <h2 class="account-section-heading">Delete account</h2>
        <p>Deleting your account permanently removes your listings and reviews. This cannot be undone.</p>
        <button class="account-delete-button" id="delete-account-open" type="button">Delete my account</button>
    </section>

    <dialog class="account-delete-dialog" id="delete-account-dialog" aria-labelledby="delete-account-heading" aria-describedby="delete-account-warning">
        <form action="/account?_method=DELETE" method="post" class="account-delete-form">
            <h2 class="account-section-heading" id="delete-account-heading">Permanently delete your account?</h2>
            <p id="delete-account-warning">Your listings, reviews, and all other account data will be permanently deleted and cannot be recovered.</p>

            <div class="listing-field">
                <label for="delete-account-password" class="listing-label">Current password</label>
                <input
                    type="password"
                    name="password"
                    id="delete-account-password"
                    class="form-control listing-input"
                    autocomplete="current-password"
                    required
                >
            </div>

            <div class="account-delete-dialog-actions">
                <button class="account-delete-cancel" type="button" id="delete-account-cancel">Cancel</button>
                <button class="account-delete-button" type="submit">Permanently delete account</button>
            </div>
        </form>
    </dialog>
</main>
