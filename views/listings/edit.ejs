<% layout("/layouts/boilerplate") %>
<body>
    <main class="listing-form-page">
        <h3 class="listing-form-heading">Edit Listing</h3>
        <form class="listing-form needs-validation" method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate enctype="multipart/form-data">
            <div class="listing-field">
                <label for="listing-title" class="listing-label">Title</label>
                <input id="listing-title" type="text" class="form-control listing-input" name="listing[title]" value="<%= listing.title %>" required>
                <div class="invalid-feedback">Please enter a title.</div>
            </div>
            <div class="listing-field">
                <label for="listing-description" class="listing-label">Description</label>
                <textarea id="listing-description" name="listing[description]" class="form-control listing-input listing-textarea" required><%= listing.description %></textarea>
                <div class="invalid-feedback">Please enter a description.</div>
            </div>
            <div class="listing-field">
                <span class="listing-label">Current image</span>
                <div class="listing-image-preview">
                    <img
                        class="listing-image-preview-img"
                        src="<%= listing.image.url %>"
                        alt="Current image for <%= listing.title %>"
                    >
                </div>
            </div>
            <div class="listing-field">
                <label for="listing-image" class="listing-label">Replace Image (optional)</label>
                <input id="listing-image" type="file" name="listing[image]" accept="image/jpeg,image/png,image/gif,image/webp,image/avif" class="form-control listing-input">
                <div class="listing-label">Leave empty to keep the current image.</div>
            </div>
            <div class="listing-field-row">
                <div class="listing-field">
                    <label for="listing-price" class="listing-label">Price per night</label>
                    <input id="listing-price" type="number" name="listing[price]" value="<%= listing.price %>" class="form-control listing-input" min="0" required>
                    <div class="invalid-feedback">Please enter a price of 0 or more.</div>
                </div>
                <div class="listing-field">
                    <label for="listing-country" class="listing-label">Country</label>
                    <input id="listing-country" type="text" name="listing[country]" value="<%= listing.country %>" class="form-control listing-input" required>
                    <div class="invalid-feedback">Please enter a country.</div>
                </div>
            </div>
            <div class="listing-field">
                <label for="listing-location" class="listing-label">Location</label>
                <input id="listing-location" type="text" name="listing[location]" value="<%= listing.location %>" class="form-control listing-input" required>
                <div class="invalid-feedback">Please enter a location.</div>
            </div>
            <button class="listing-submit" type="submit">Save Changes</button>
        </form>
    </main>
</body>
