<% layout("/layouts/boilerplate") %>
<body>

    <h3>All Listings</h3>

    <!-- row-cols-lg-3 strictly forces exactly 3 columns per row on large screens -->
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-1">
        <% for (let listing of allListings){ %> 
            
            <div class="card col" style="width: 20rem; cursor: pointer;" onclick="window.location.href='/listings/<%= listing._id %>'">
                <img src="<%= listing.image.url %>" class="card-img" alt="<%= listing.image.filename %>" style="height: 20rem;">
                <div class="card-body">                      
                    <p class="card-text"> <b><%= listing.title %></b><br> <%= listing.price.toLocaleString("en-IN") %> / night</p>
                </div>
            </div>
            </a>
                
        <% } %>
    </div>

</body>