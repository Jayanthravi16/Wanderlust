<% layout("/layouts/boilerplate") %>
<body>

    <nav class="category-filter" aria-label="Filter listings by category">
        <div class="category-filter-track">
            <a class="category-filter-item <%= selectedCategory === 'all' ? 'is-selected' : '' %>"
               href="/listings<%= searchTerm ? '?q=' + encodeURIComponent(searchTerm) : '' %>"
               <% if (selectedCategory === 'all') { %>aria-current="page"<% } %>>
                <i class="fa-solid fa-compass" aria-hidden="true"></i>
                <span>All</span>
            </a>
            <% for (const category of listingCategories) { %>
                <a class="category-filter-item <%= selectedCategory === category.value ? 'is-selected' : '' %>"
                   href="/listings?category=<%= encodeURIComponent(category.value) %><%= searchTerm ? '&q=' + encodeURIComponent(searchTerm) : '' %>"
                   <% if (selectedCategory === category.value) { %>aria-current="page"<% } %>>
                    <i class="<%= category.icon %>" aria-hidden="true"></i>
                    <span><%= category.label %></span>
                </a>
            <% } %>
        </div>
    </nav>

    <div class="listings-grid">
        <% for (let listing of allListings){ %> 
            <a class="listing-card" href="/listings/<%= listing._id %>">
                <div class="listing-card-image-wrap">
                    <img src="<%= listing.image.url %>" class="listing-card-image" alt="<%= listing.image.filename %>">
                    <div class="listing-card-overlay" aria-hidden="true"></div>
                </div>
                <div class="listing-card-body">
                    <p class="listing-card-text"><b><%= listing.title %></b><br><%= listing.price.toLocaleString("en-IN") %> / night</p>
                </div>
            </a>
        <% } %>
    </div>
    <% if (allListings.length === 0) { %>
        <p class="listings-empty-state">
            <% if (searchTerm) { %>
                No stays matched “<%= searchTerm %>”. Try a different name or destination.
            <% } else { %>
                No listings found in this category yet.
            <% } %>
        </p>
    <% } %>

</body>