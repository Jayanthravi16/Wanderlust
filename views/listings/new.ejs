<% layout("/layouts/boilerplate") %>
<body>
    <main class="listing-form-page">
        <h3 class="listing-form-heading">Create a New Listing</h3>
        <form class="listing-form needs-validation" method="POST" action="/listings" novalidate>
            <div class="listing-field">
                <label for="listing-title" class="listing-label">Title</label>
                <input id="listing-title" type="text" class="form-control listing-input" name="listing[title]" placeholder="Enter a listing title" required>
                <div class="invalid-feedback">Please enter a title.</div>
            </div>
            <div class="listing-field">
                <label for="listing-description" class="listing-label">Description</label>
                <textarea id="listing-description" name="listing[description]" class="form-control listing-input listing-textarea" placeholder="Describe your place" required></textarea>
                <div class="invalid-feedback">Please enter a description.</div>
            </div>
            <div class="listing-field">
                <label for="listing-image" class="listing-label">Image URL</label>
                <input id="listing-image" type="url" name="listing[image][url]" placeholder="https://example.com/image.jpg" class="form-control listing-input" required>
                <div class="invalid-feedback">Please enter a valid image URL.</div>
            </div>
            <div class="listing-field-row">
                <div class="listing-field">
                    <label for="listing-price" class="listing-label">Price per night</label>
                    <input id="listing-price" type="number" name="listing[price]" placeholder="Enter price" class="form-control listing-input" min="0" required>
                    <div class="invalid-feedback">Please enter a price of 0 or more.</div>
                </div>
                <div class="listing-field">
                    <label for="listing-country" class="listing-label">Country</label>
                    <input id="listing-country" type="text" name="listing[country]" placeholder="Enter country" class="form-control listing-input" required>
                    <div class="invalid-feedback">Please enter a country.</div>
                </div>
            </div>
            <div class="listing-field">
                <label for="listing-location" class="listing-label">Location</label>
                <input id="listing-location" type="text" name="listing[location]" placeholder="Enter location" class="form-control listing-input" required>
                <div class="invalid-feedback">Please enter a location.</div>
            </div>
            <button class="listing-submit" type="submit">Add Listing</button>
        </form>
    </main>
</body>
