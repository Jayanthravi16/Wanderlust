<% if (success && success.length) { %>
    <div class="flash-stack" aria-live="polite">
        <% success.forEach((message) => { %>
            <div class="flash-message" role="status">
                <span class="flash-message-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="m5 12.5 4.25 4.25L19 7"></path>
                    </svg>
                </span>
                <p class="flash-message-text"><%= message %></p>
                <button class="flash-message-dismiss" type="button" aria-label="Dismiss message">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        <% }) %>
    </div>
<% } %>

<% if (error && error.length) { %>
    <div class="flash-stack" aria-live="assertive">
        <% error.forEach((message) => { %>
            <div class="flash-message flash-message-error" role="alert">
                <span class="flash-message-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 8v5"></path>
                        <path d="M12 17h.01"></path>
                        <circle cx="12" cy="12" r="9"></circle>
                    </svg>
                </span>
                <p class="flash-message-text"><%= message %></p>
                <button class="flash-message-dismiss" type="button" aria-label="Dismiss error message">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        <% }) %>
    </div>
<% } %>
