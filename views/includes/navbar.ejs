<nav class="site-navbar" aria-label="Main navigation">
    <div class="site-navbar-inner">
        <a class="site-brand" href="/listings" aria-label="WanderLust home">
            <i class="fa-regular fa-compass" aria-hidden="true"></i>
            <span>WanderLust</span>
        </a>

        <form class="site-search" action="/listings" method="get" role="search">
            <label class="visually-hidden" for="site-search-input">Search stays by name or destination</label>
            <i class="fa-solid fa-magnifying-glass site-search-icon" aria-hidden="true"></i>
            <input
                id="site-search-input"
                class="site-search-input"
                type="search"
                name="q"
                value="<%= locals.searchTerm %>"
                placeholder="Search stays or destinations"
                autocomplete="off"
            >
            <% if (currentPath === "/listings" && selectedCategory && selectedCategory !== "all") { %>
                <input type="hidden" name="category" value="<%= selectedCategory %>">
            <% } %>
            <button class="site-search-submit" type="submit" aria-label="Search stays">
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </button>
        </form>

        <button
            class="site-menu-toggle"
            type="button"
            aria-controls="site-navbar-menu"
            aria-expanded="false"
            aria-label="Open navigation menu"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="site-navbar-menu" id="site-navbar-menu">
            <ul class="site-nav-links">
                <li>
                    <a
                        class="site-nav-link <%= currentPath === '/listings' || (currentPath.startsWith('/listings/') && currentPath !== '/listings/new' && !currentPath.endsWith('/edit')) ? 'is-active' : '' %>"
                        href="/listings"
                        <% if (currentPath === "/listings" || (currentPath.startsWith("/listings/") && currentPath !== "/listings/new" && !currentPath.endsWith("/edit"))) { %>aria-current="page"<% } %>
                    >Explore stays</a>
                </li>
                <% if (currUser) { %>
                    <li>
                        <a
                            class="site-nav-link <%= currentPath === '/listings/new' || currentPath.endsWith('/edit') ? 'is-active' : '' %>"
                            href="/listings/new"
                            <% if (currentPath === "/listings/new" || currentPath.endsWith("/edit")) { %>aria-current="page"<% } %>
                        >Add a listing</a>
                    </li>
                <% } %>
            </ul>

            <div class="site-nav-account">
                <% if (currUser) { %>
                    <div class="site-profile-menu">
                        <a
                            class="site-profile-avatar"
                            href="/account"
                            title="Manage profile for <%= currUser.username %>"
                            aria-label="Manage profile for <%= currUser.username %>"
                        ><%= currUser.username.charAt(0).toUpperCase() %></a>
                        <div class="site-profile-dropdown">
                            <span class="site-profile-dropdown-name"><%= currUser.username %></span>
                            <a href="/account" <% if (currentPath === "/account") { %>aria-current="page"<% } %>>Manage profile</a>
                        </div>
                    </div>
                    <form action="/logout" method="post">
                        <button class="site-account-button site-logout-button" type="submit">Log out</button>
                    </form>
                <% } else { %>
                    <a class="site-account-button <%= currentPath === '/login' ? 'is-active' : '' %>" href="/login" <% if (currentPath === "/login") { %>aria-current="page"<% } %>>Log in</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>
